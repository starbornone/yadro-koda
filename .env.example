# Copy to `.env` and fill in from Supabase Dashboard → Project Settings → API.
# Only VITE_-prefixed variables are exposed to the browser bundle.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-side only (never VITE_-prefixed): the session-pooler connection string from the
# dashboard (Connect → Session pooler). Used by `pnpm db:types`; keep it in `.env.local`.
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# Optional, server-side only: a personal access token (dashboard → Account → Access Tokens) for
# the Supabase CLI — `supabase link`, `supabase config push`. Keep it in `.env.local`.
# SUPABASE_ACCESS_TOKEN=sbp_...
